        "frag": "\nprecision highp float;\nvarying vec2 uv0;\nvarying vec4 batchData;\nuniform sampler2D texture;\nuniform vec4 uvOriginAxisX;\nuniform vec4 uvAxisY;\nuniform vec4 motionParams;\nconst float PI = 3.141592653589793;\nconst float TWO_PI = 6.283185307179586;\nconst float OUTER_SHARD_COUNT = 8.0;\nconst float UINT16_MAX_VALUE = 65535.0;\nfloat decodeUnitIntervalFromUint16(float highByte, float lowByte) {\n  float high = floor(highByte * 255.0 + 0.5);\n  float low = floor(lowByte * 255.0 + 0.5);\n  return (high * 256.0 + low) / UINT16_MAX_VALUE;\n}\nfloat hash11(float value) {\n  return fract(sin(value) * 43758.5453123);\n}\nvec2 rotatePoint(vec2 point, float angle) {\n  float sine = sin(angle);\n  float cosine = cos(angle);\n  return vec2(\n    cosine * point.x - sine * point.y,\n    sine * point.x + cosine * point.y\n  );\n}\nfloat wrapAngle(float angle) {\n  return mod(mod(angle, TWO_PI) + TWO_PI, TWO_PI);\n}\nfloat resolvePieceIndex(vec2 sourcePoint, float seedAngle) {\n  vec2 centered = sourcePoint - vec2(0.5);\n  float radius = length(centered);\n  float angle = atan(centered.y, centered.x);\n  float centerRadius = 0.19 + 0.025 * sin(angle * 3.0 + seedAngle * 2.0);\n  if (radius < centerRadius) {\n    return 0.0;\n  }\n  float sectorAngle = TWO_PI / OUTER_SHARD_COUNT;\n  return floor(wrapAngle(angle - seedAngle) / sectorAngle) + 1.0;\n}\nbool insideUnitSquare(vec2 point) {\n  return point.x >= 0.0 && point.x <= 1.0 && point.y >= 0.0 && point.y <= 1.0;\n}\nvec2 toAtlasUv(vec2 localUv) {\n  return uvOriginAxisX.xy + uvOriginAxisX.zw * localUv.x + uvAxisY.xy * localUv.y;\n}\nvec4 frag () {\n  float seed = decodeUnitIntervalFromUint16(batchData.r, batchData.g);\n  float normalizedAge = decodeUnitIntervalFromUint16(batchData.b, batchData.a);\n  vec4 shatterParams = vec4(normalizedAge * 0.48, 0.48, seed, 3.0);\n  normalizedAge = clamp(shatterParams.x / shatterParams.y, 0.0, 1.0);\n  float burstProgress = 1.0 - pow(1.0 - normalizedAge, 3.0);\n  float seedAngle = shatterParams.z * TWO_PI;\n  vec2 localUv = uv0;\n  vec2 outputPoint = (localUv - vec2(0.5)) * shatterParams.w + vec2(0.5);\n  vec4 result = vec4(0.0);\n  float claimed = 0.0;\n  for (int shardIndex = 0; shardIndex < 9; ++shardIndex) {\n    float shard = float(shardIndex);\n    float randomValue = hash11(shatterParams.z * 113.0 + shard * 19.17 + 0.37);\n    float directionAngle = seedAngle + randomValue * 0.7;\n    if (shardIndex > 0) {\n      directionAngle = seedAngle + (shard - 0.5) * TWO_PI / OUTER_SHARD_COUNT;\n      directionAngle += (randomValue - 0.5) * 0.34;\n    }\n    vec2 direction = vec2(cos(directionAngle), sin(directionAngle));\n    float speed = mix(0.38, 0.78, randomValue);\n    if (shardIndex == 0) {\n      speed *= 0.58;\n    }\n    vec2 offset = direction * speed * motionParams.x * burstProgress;\n    offset.y -= motionParams.y * normalizedAge * normalizedAge;\n    float rotationSign = randomValue < 0.5 ? -1.0 : 1.0;\n    float rotation = rotationSign * mix(0.45, 1.0, randomValue) * motionParams.z * burstProgress;\n    vec2 pivot = vec2(0.5);\n    if (shardIndex > 0) {\n      pivot += direction * 0.29;\n    }\n    vec2 sourcePoint = rotatePoint(outputPoint - offset - pivot, -rotation) + pivot;\n    if (!insideUnitSquare(sourcePoint)) {\n      continue;\n    }\n    float pieceIndex = resolvePieceIndex(sourcePoint, seedAngle);\n    float belongs = 1.0 - step(0.25, abs(pieceIndex - shard));\n    belongs *= 1.0 - claimed;\n    if (belongs > 0.5) {\n      vec4 sampledColor = vec4(1.0);\n  vec4 texture_tmp = texture2D(texture, toAtlasUv(sourcePoint));\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture2D(texture, toAtlasUv(sourcePoint) + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    sampledColor.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    sampledColor.a *= texture_tmp.a;\n  #else\n    sampledColor *= texture_tmp;\n  #endif\n      #if USE_BGRA\n        sampledColor = sampledColor.bgra;\n      #endif\n      result = sampledColor;\n      claimed = 1.0;\n    }\n  }\n  float fade = 1.0 - smoothstep(motionParams.w, 1.0, normalizedAge);\n  result.a *= fade;\n  if (result.a <= 0.003) {\n    discard;\n  }\n  return result;\n}\nvoid main() { gl_FragColor = frag(); }"
      },
