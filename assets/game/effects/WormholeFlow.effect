CCEffect %{
  techniques:
  - passes:
    - vert: wormhole-flow-vs:vert
      frag: wormhole-flow-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        uvOriginAxisX: { value: [0.0, 0.0, 1.0, 0.0] }
        uvAxisY: { value: [0.0, 1.0, 1.0, 1.0] }
        motionParams: { value: [0.55, 4.8, 1.6, 2.0] }
        shapeParams: { value: [0.44, 0.33, 0.025, 0.13] }
        blueHighlight: { value: [0.10, 0.65, 1.0, 1.0] }
        purpleHighlight: { value: [0.55, 0.18, 1.0, 1.0] }
}%

CCProgram wormhole-flow-vs %{
  precision highp float;
  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec2 a_uv0;
  in vec4 a_color;

  out vec2 localUv;
  out vec4 vertexColor;

  uniform WormholeUv {
    vec4 uvOriginAxisX;
    vec4 uvAxisY;
  };

  vec2 toLocalUv(vec2 atlasUv) {
    vec2 origin = uvOriginAxisX.xy;
    vec2 axisX = uvOriginAxisX.zw;
    vec2 axisY = uvAxisY.xy;
    vec2 delta = atlasUv - origin;
    return vec2(
      dot(delta, axisX) / uvAxisY.z,
      dot(delta, axisY) / uvAxisY.w
    );
  }

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if CC_USE_MODEL
      pos = cc_matViewProj * cc_matWorld * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif
    localUv = toLocalUv(a_uv0);
    vertexColor = a_color;
    return pos;
  }
}%

CCProgram wormhole-flow-fs %{
  precision highp float;
  #include <cc-global>
  #include <texture>

  in vec2 localUv;
  in vec4 vertexColor;

  uniform sampler2D texture;
  uniform WormholeUv {
    vec4 uvOriginAxisX;
    vec4 uvAxisY;
  };
  uniform WormholeMotion {
    vec4 motionParams;
    vec4 shapeParams;
  };
  uniform WormholeHighlight {
    vec4 blueHighlight;
    vec4 purpleHighlight;
  };

  vec2 rotatePoint(vec2 point, float angle) {
    float sine = sin(angle);
    float cosine = cos(angle);
    return vec2(
      cosine * point.x - sine * point.y,
      sine * point.x + cosine * point.y
    );
  }

  vec2 toAtlasUv(vec2 uv) {
    return uvOriginAxisX.xy + uvOriginAxisX.zw * uv.x + uvAxisY.xy * uv.y;
  }

  vec4 frag () {
    float time = cc_time.x;
    vec2 centered = localUv - vec2(0.5);
    float radius = length(centered);

    float centerStrength = 1.0 - clamp(radius / shapeParams.x, 0.0, 1.0);
    centerStrength *= centerStrength;
    float centerPulse = 0.5 + 0.5 * sin(time * motionParams.w);
    float rotationAngle = -time * motionParams.x * centerStrength * (0.45 + 1.55 * centerStrength);
    float suctionMask = 1.0 - smoothstep(0.025, shapeParams.w * 1.85, radius);
    float suctionScale = 1.0 + suctionMask * (0.045 + 0.025 * centerPulse);
    vec2 sourceUv = rotatePoint(centered, rotationAngle) * suctionScale + vec2(0.5);
    sourceUv = clamp(sourceUv, vec2(0.001), vec2(0.999));

    vec4 sampledColor = vec4(1.0);
    CCTexture(texture, toAtlasUv(sourceUv), sampledColor);
    #if USE_BGRA
      sampledColor = sampledColor.bgra;
    #endif

    float sourceAngle = atan(centered.y, centered.x);
    float ringDistance = abs(radius - shapeParams.y);
    float ringMask = 1.0 - smoothstep(shapeParams.z, shapeParams.z * 2.2, ringDistance);
    float sweepWave = 0.5 + 0.5 * cos(sourceAngle - time * motionParams.y);
    float sweepHead = pow(sweepWave, 12.0);
    float sweepTailWave = 0.5 + 0.5 * cos(sourceAngle - time * motionParams.y + 0.55);
    float sweepTail = pow(sweepTailWave, 20.0) * 0.38;
    float streakMask = ringMask * clamp(sweepHead + sweepTail, 0.0, 1.0);

    float breath = 0.5 + 0.5 * sin(time * motionParams.z);
    float brightestChannel = max(sampledColor.r, max(sampledColor.g, sampledColor.b));
    float starMask = smoothstep(0.58, 0.96, brightestChannel);
    starMask *= 1.0 - smoothstep(0.46, 0.53, radius);
    float edgeMask = smoothstep(0.36, 0.47, radius) * (1.0 - smoothstep(0.48, 0.54, radius));

    float coreRadius = shapeParams.w * (0.92 + 0.08 * centerPulse);
    float coreMask = 1.0 - smoothstep(coreRadius * 0.42, coreRadius * 1.18, radius);
    float coreRim = 1.0 - smoothstep(0.010, 0.032, abs(radius - coreRadius));

    vec3 resultRgb = sampledColor.rgb;
    resultRgb *= 1.0 + starMask * (0.045 + 0.095 * breath);
    resultRgb += blueHighlight.rgb * streakMask * 0.72 * sampledColor.a;
    resultRgb += purpleHighlight.rgb * edgeMask * (0.025 + 0.045 * breath) * sampledColor.a;
    resultRgb += mix(purpleHighlight.rgb, blueHighlight.rgb, centerPulse) * coreRim * 0.08 * sampledColor.a;
    resultRgb *= 1.0 - coreMask * (0.16 + 0.07 * centerPulse);

    vec4 result = vec4(resultRgb, sampledColor.a) * vertexColor;
    if (result.a <= 0.003) {
      discard;
    }
    return result;
  }
}%
