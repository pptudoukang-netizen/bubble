        "frag": "\nprecision highp float;\nvarying vec2 uv0;\nvarying vec4 color;\nuniform sampler2D texture;\nuniform vec4 uvOriginAxisX;\nuniform vec4 uvAxisY;\nuniform vec4 glowColor;\nuniform vec4 glowParams;\nbool insideUnitSquare(vec2 point) {\n  return point.x >= 0.0 && point.x <= 1.0 && point.y >= 0.0 && point.y <= 1.0;\n}\nvec2 toLocalUv(vec2 atlasUv) {\n  vec2 origin = uvOriginAxisX.xy;\n  vec2 axisX = uvOriginAxisX.zw;\n  vec2 axisY = uvAxisY.xy;\n  vec2 delta = atlasUv - origin;\n  return vec2(\n    dot(delta, axisX) / uvAxisY.z,\n    dot(delta, axisY) / uvAxisY.w\n  );\n}\nvec2 toAtlasUv(vec2 localUv) {\n  return uvOriginAxisX.xy + uvOriginAxisX.zw * localUv.x + uvAxisY.xy * localUv.y;\n}\nfloat sampleAlpha(vec2 localUv) {\n  if (!insideUnitSquare(localUv)) {\n    return 0.0;\n  }\n  vec4 sampledColor = vec4(1.0);\n  vec4 texture_tmp = texture2D(texture, toAtlasUv(localUv));\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture2D(texture, toAtlasUv(localUv) + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    sampledColor.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    sampledColor.a *= texture_tmp.a;\n  #else\n    sampledColor *= texture_tmp;\n  #endif\n  #if USE_BGRA\n    sampledColor = sampledColor.bgra;\n  #endif\n  return sampledColor.a;\n}\nvec4 frag () {\n  vec2 localUv = toLocalUv(uv0);\n  float radius = glowParams.y;\n  vec2 stepX = vec2(radius, 0.0);\n  vec2 stepY = vec2(0.0, radius);\n  vec2 stepD = vec2(radius * 0.70710678, radius * 0.70710678);\n  float centerAlpha = sampleAlpha(localUv);\n  float sample0 = sampleAlpha(localUv + stepX);\n  float sample1 = sampleAlpha(localUv - stepX);\n  float sample2 = sampleAlpha(localUv + stepY);\n  float sample3 = sampleAlpha(localUv - stepY);\n  float sample4 = sampleAlpha(localUv + stepD);\n  float sample5 = sampleAlpha(localUv - stepD);\n  float sample6 = sampleAlpha(localUv + vec2(stepD.x, -stepD.y));\n  float sample7 = sampleAlpha(localUv + vec2(-stepD.x, stepD.y));\n  float neighborMax = max(max(max(sample0, sample1), max(sample2, sample3)), max(max(sample4, sample5), max(sample6, sample7)));\n  float neighborMin = min(min(min(sample0, sample1), min(sample2, sample3)), min(min(sample4, sample5), min(sample6, sample7)));\n  float outerGlow = max(neighborMax - centerAlpha, 0.0);\n  float innerRim = centerAlpha * max(centerAlpha - neighborMin, 0.0);\n  float bodyCover = centerAlpha * glowParams.w;\n  float alpha = (outerGlow * 0.72 + innerRim * 0.68 + bodyCover) * glowParams.z;\n  alpha *= 0.86 + glowParams.x * 0.34;\n  if (alpha <= 0.003) {\n    discard;\n  }\n  return vec4(glowColor.rgb, min(alpha, 1.0) * color.a * glowColor.a);\n}\nvoid main() { gl_FragColor = frag(); }"
